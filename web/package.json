{
  "name": "molecular-surfaces-web",
  "private": true,
  "version": "1.0.0",
  "description": "Browser port of the MolecularSurfaces protein viewer: SDF + marching-cubes molecular surfaces with SSAO and chain outlines.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
